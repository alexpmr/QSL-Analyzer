{
  "name": "pt2vhf-qsl-manager",
  "version": "0.6.0",
  "private": true,
  "description": "Gerenciador de contatos e confirmações QSL para radioamadores: importação, edição, sincronização com plataformas, estatísticas e diplomas",
  "author": {
    "name": "Alex Rodrigues, PT2VHF",
    "email": "alexpmr@gmail.com"
  },
  "license": "MIT",
  "main": "desktop/main.cjs",
  "repository": "https://github.com/alexpmr/QSL-Analyzer",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "preview": "python3 -m http.server 8094 --bind 127.0.0.1",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "br.pt2vhf.qslanalyzer",
    "productName": "PT2VHF QSL Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "PT2VHF-QSL-Manager-${version}-win-${arch}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "PT2VHF-QSL-Manager-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "HamRadio",
      "maintainer": "Alex Rodrigues, PT2VHF <alexpmr@gmail.com>",
      "synopsis": "Análise de logs de radioamador e confirmações QSL",
      "artifactName": "PT2VHF-QSL-Manager-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "pt2vhf-qsl-manager_${version}_${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "PT2VHF-QSL-Manager-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "PT2VHF-QSL-Manager-${version}-mac-${arch}.${ext}"
    }
  },
  "homepage": "https://www.pt2vhf.com/qsl"
}
